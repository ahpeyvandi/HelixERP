{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HelixDb": "Server=localhost;Database=HelixERP;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "HelixERP.Shell",
    "Audience": "HelixERP.Clients",
    "SigningKey": "helix-dev-signing-key-change-me-in-production-2026",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Authentication": {
    "LocalEnabled": true,
    "LdapEnabled": false,
    "OidcEnabled": false,
    "Ldap": {
      "Server": "",
      "Port": 389,
      "BaseDn": "",
      "Domain": ""
    },
    "Oidc": {
      "Authority": "http://localhost:5001",
      "ClientId": "helix-shell",
      "ClientSecret": "helix-shell-secret-2026",
      "Scopes": "openid profile email groups",
      "CallbackPath": "/api/auth/oidc/callback",
      "FrontendRedirectUri": "http://localhost:5173",
      "AutoProvisionUsers": true,
      "DefaultGroup": "base.group_user",
      "GroupClaim": "groups",
      "GroupClaimMappings": {
        "ERP_Admins": "base.group_erp_manager",
        "ERP_Settings": "base.group_system"
      }
    }
  },
  "Bootstrap": {
    "MigrateDatabase": true,
    "SeedOnStartup": true,
    "AdminLogin": "admin",
    "AdminEmail": "admin@helix.local",
    "AdminDisplayName": "Administrator",
    "AdminPassword": "Helix@12345"
  },
  "Gateway": {
    "RefreshSeconds": 30
  },
  "FileStorage": {
    "RootPath": "volumes/files",
    "MaxFileSizeBytes": 104857600
  }
}