<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { color-scheme: light; }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Vazirmatn", system-ui, -apple-system, "Segoe UI", sans-serif;
            background: #f1f5f9;
            color: #0f172a;
        }
        .login-card {
            max-width: 24rem;
            margin: 5rem auto 0;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            padding: 2rem;
            box-shadow: 0 10px 30px -12px rgb(15 23 42 / 0.2);
        }
        h1 { font-size: 1.25rem; margin: 0 0 0.25rem; }
        p { color: #475569; font-size: 0.875rem; }
        label { display: block; margin-top: 0.75rem; font-size: 0.8rem; font-weight: 600; }
        input {
            width: 100%;
            padding: 0.6rem 0.75rem;
            margin-top: 0.25rem;
            border: 1px solid #cbd5e1;
            border-radius: 0.5rem;
            font-size: 0.9rem;
        }
        button {
            margin-top: 1rem;
            width: 100%;
            padding: 0.65rem;
            background: #4f46e5;
            color: #fff;
            border: 0;
            border-radius: 0.5rem;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
        }
        .alert { background: #fee2e2; color: #b91c1c; padding: 0.5rem 0.75rem; border-radius: 0.5rem; font-size: 0.8rem; margin-top: 0.75rem; }
        .hint { margin-top: 1rem; font-size: 0.75rem; color: #64748b; }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
